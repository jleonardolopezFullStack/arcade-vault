# Clave de API de Resend. Sin ella la aplicación entra en MODO SIMULACIÓN:
# no se llama a Resend y el mensaje se vuelca por la consola del servidor.
RESEND_API_KEY=

# Buzón que recibe los mensajes del formulario de /acerca-de. Con el remitente
# de pruebas onboarding@resend.dev, Resend SOLO entrega al correo dueño de la
# cuenta: cambiarlo por otro buzón devuelve 403 hasta verificar un dominio.
CONTACT_TO_EMAIL=jleonardolopez@hotmail.com

# Remitente. OJO: Resend NO permite enviar desde una dirección @gmail.com;
# el `from` debe ser un dominio verificado en la cuenta o onboarding@resend.dev.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>
